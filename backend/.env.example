# Native development only. Copy to .env and supply your own values.
DATABASE_URL=postgresql+psycopg2://admin:admin123@127.0.0.1:5433/ai_assistant
JWT_SECRET=replace-with-a-random-secret-generated-locally
ENABLE_DEMO=true
DEMO_ONLY=false
DEMO_AI_PROVIDER=simulated
CONVERSATION_AI_PROVIDER=simulated
# Optional real AI. Ollama runs on the computer hosting the backend.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CONVERSATION_MODEL=qwen3:14b
OLLAMA_KEEP_ALIVE=30m
OPENAI_API_KEY=
OPENAI_CONVERSATION_MODEL=
# Real WhatsApp and Mercado Pago require your own account credentials.
# See docs/INTEGRATIONS.md. Do not paste credentials into tracked files.
WHATSAPP_CHANNELS={}
WHATSAPP_GRAPH_VERSION=v25.0
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
MERCADO_PAGO_SELLERS={}
